# The orchestrator's settings (deploy/docker-compose.yml). Never commit the filled-in .env.
FORGERUN_DOMAIN=forgerun.example.com
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Pushing branches and pull requests (also the fallback for users without a token)
GITHUB_TOKEN=

# Sign-in with GitHub: an OAuth App with callback https://<FORGERUN_DOMAIN>/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# openssl rand -hex 32
FORGERUN_SECRET_KEY=
# Your GitHub username (comma-separated for several admins)
FORGERUN_ADMINS=

# Workers connect with this, the same value on every worker: openssl rand -hex 32
FORGERUN_WORKER_TOKEN=
