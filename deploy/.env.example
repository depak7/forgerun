# The orchestrator's settings (deploy/docker-compose.yml). Never commit the filled-in .env.
# Where browsers reach forgerun, e.g. http://203.0.113.7:8080 or https://forgerun.example.com
FORGERUN_PUBLIC_URL=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Pushing branches and pull requests
GITHUB_TOKEN=

# Your sign-in. The password needs at least 12 characters: openssl rand -base64 18
FORGERUN_USERNAME=
FORGERUN_PASSWORD=
# A website ID for the analytics script at cloud.umami.is. Unset, the pages load no analytics.
FORGERUN_ANALYTICS_WEBSITE_ID=

# Workers connect with this, the same value on every worker: openssl rand -hex 32
FORGERUN_WORKER_TOKEN=
