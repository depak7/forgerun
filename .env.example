# Copy to .env and fill in. Each agent's credential is only needed for tasks on that agent;
# serve starts with any of them missing. GITHUB_TOKEN is required: serve pushes branches with it.
# Load and start:  set -a; . ./.env; set +a; go run ./cmd/forgerun serve
CURSOR_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: OpenCode's paid models (its free ones need no key). A key from an
# OpenCode Console service account with "Inference only" permission.
OPENCODE_API_KEY=
# pi: one key per provider whose models you'll pick (pi's subscription logins
# can't be used: they keep refreshing tokens inside the VM).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Sign-in (optional on 127.0.0.1, required on an address other machines can reach).
# The password needs at least 12 characters.
FORGERUN_USERNAME=
FORGERUN_PASSWORD=
# Only these addresses may connect (comma-separated IPs or ranges, e.g. your tailnet's
# 100.64.0.0/10). Empty: any address, behind sign-in.
FORGERUN_ALLOW_FROM=
FORGERUN_PUBLIC_URL=http://localhost:8080
# true: serve only the public landing page (no API, no database needed)
FORGERUN_LANDING_ONLY=
# A website ID for the analytics script at cloud.umami.is. Unset, the pages load no analytics.
FORGERUN_ANALYTICS_WEBSITE_ID=

# Running workers on other machines (optional; forgerun serve runs everything in one process).
# The orchestrator (forgerun server) and its workers (forgerun worker) share this token:
#   openssl rand -hex 32
FORGERUN_WORKER_TOKEN=
# On a worker: the orchestrator's address (or pass -server)
FORGERUN_SERVER=
