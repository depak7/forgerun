# Copy to .env and fill in. Each agent's credential is only needed for tasks on that agent;
# serve starts with any of them missing. GITHUB_TOKEN is required: serve pushes branches with it.
# Load and start:  set -a; . ./.env; set +a; go run ./cmd/forgerun serve
CURSOR_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
GITHUB_TOKEN=

# Sign-in with GitHub (optional; without GITHUB_OAUTH_CLIENT_ID forgerun runs in local mode:
# no accounts, everything is yours). Create an OAuth App at github.com/settings/developers
# with the callback URL <FORGERUN_PUBLIC_URL>/auth/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
FORGERUN_PUBLIC_URL=http://localhost:8080
# Encrypts users' GitHub tokens in the database: openssl rand -hex 32
FORGERUN_SECRET_KEY=
# GitHub usernames that can see everything and the settings, comma-separated
FORGERUN_ADMINS=
